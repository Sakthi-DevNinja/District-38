# VITE_API_BASE_URL (required): base URL of the VEYONN backend's public API,
# e.g. https://district38.co.in when the web server proxies /api on the
# storefront's own domain, or https://api.district38.co.in. The site refuses
# to start without it. Never put credentials or tenant/company IDs here (the
# public storefront API resolves those server-side).
# Careful: Vite also reads .env.local for production builds. Build with
# VITE_API_BASE_URL=https://... npm run build (or a .env.production.local)
# so a local dev value never ships.
VITE_API_BASE_URL=

# SITE_URL: the public storefront URL, used by `npm run sitemap` to write
# absolute links into public/sitemap.xml (e.g. https://district38.co.in).
SITE_URL=

# VEYONN_DEV_PROXY_TARGET: local dev only — where `npm run dev` proxies
# /api (defaults to http://localhost:3000).
VEYONN_DEV_PROXY_TARGET=
