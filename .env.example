# VITE_API_BASE_URL: Base URL of the VEYONN backend's public API
# (e.g. https://api.veyonn.example.com). Leave empty when the web server
# proxies /api on the storefront's own domain. District 38 is a pure client
# of this backend — never hardcode this in code, and never put credentials
# or tenant/company IDs here (the public storefront API resolves those
# server-side).
VITE_API_BASE_URL=

# SITE_URL: the public storefront URL, used by `npm run sitemap` to write
# absolute links into public/sitemap.xml (e.g. https://district38.co.in).
SITE_URL=

# VEYONN_DEV_PROXY_TARGET: local dev only — where `npm run dev` proxies
# /api (defaults to http://localhost:3000).
VEYONN_DEV_PROXY_TARGET=
